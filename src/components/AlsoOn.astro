                )}
                {getExternalLinkType(link) === "bookhive" && (
                    <span class="sr-only">BookHive</span>
                    <!-- Barry's geometry is extracted from BookHive's book_no_bookmark.svg and
                    rendered as monochrome line art. Original artwork by Nick Perez, MIT licensed:
                    https://github.com/nperez0111/bookhive/blob/main/public/book_no_bookmark.svg -->
                    <svg
                        aria-hidden="true"
                        width="24"
                        height="24"
                        viewBox="110 75 360 350"
                        astro-icon="social/bookhive"
                    >
                        <defs>
                            <mask id="bookhive-bee-mask" maskUnits="userSpaceOnUse" x="110" y="75" width="360" height="350">
