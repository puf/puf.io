                        <ellipse cx="350" cy="217" rx="10" ry="11" fill="currentColor" stroke="none" />
                    </svg>
                )}
                {getExternalLinkType(link) === "medium" && (
                    <span class="sr-only">Medium</span>
                    <svg aria-hidden="true" width="24" height="24" viewBox="0 0 1043.63 592.71"><path d="M588.67 296.36c0 163.67-131.78 296.35-294.33 296.35S0 460 0 296.36 131.78 0 294.34 0s294.33 132.69 294.33 296.36M911.56 296.36c0 154.06-65.89 279-147.17 279s-147.17-124.94-147.17-279 65.88-279 147.16-279 147.17 124.9 147.17 279M1043.63 296.36c0 138-23.17 249.94-51.76 249.94s-51.75-111.91-51.75-249.94 23.17-249.94 51.75-249.94 51.76 111.9 51.76 249.94"></path></svg>
                )}
                {getExternalLinkType(link) === "bluesky" && (
                    <span class="sr-only">Bluesky</span>
                    <svg aria-hidden="true" width="24" height="24" viewBox="-0.173 24.7496 500.039 440.2732" width="500.039px" height="440.273px"><path d="M 108.217 54.385 C 165.545 97.424 227.208 184.688 249.848 231.519 C 272.489 184.691 334.148 97.423 391.479 54.385 C 432.843 23.331 499.866 -0.698 499.866 75.762 C 499.866 91.032 491.111 204.038 485.976 222.384 C 468.127 286.168 403.088 302.437 345.233 292.59 C 446.361 309.801 472.087 366.813 416.529 423.824 C 311.013 532.099 264.871 396.657 253.043 361.953 C 250.875 355.591 249.861 352.614 249.847 355.144 C 249.831 352.614 248.817 355.591 246.65 361.953 C 234.827 396.657 188.687 532.102 83.164 423.824 C 27.605 366.813 53.331 309.798 154.46 292.59 C 96.604 302.437 31.563 286.168 13.717 222.384 C 8.582 204.037 -0.173 91.03 -0.173 75.762 C -0.173 -0.698 66.851 23.331 108.214 54.385 L 108.217 54.385 Z" style="stroke-width: 1;"/></svg>
                )}
                {getExternalLinkType(link) === "stackoverflow" && (
                    <span class="sr-only">Stack Overflow</span>
                    <svg aria-hidden="true" width="24" height="24" fill="#000000" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><title>ionicons-v5_logos</title><path d="M392,440V320h40V480H64V320h40V440Z"></path><path d="M149.1,308.77l198.57,40.87,8.4-39.32L157.5,269.45Zm26.27-93.12L359.22,300,376,263.76,192.18,178.92Zm50.95-89,156,127.78,25.74-30.52-156-127.78ZM328,32,294.61,55.8,415.43,216.17,448,192ZM144,400H348V360H144Z"></path></g></svg>
                )}
                {!getExternalLinkType(link) && <span>{getExternalLinkLabel(link)}</span>}

