        ))}
    </div>
    <hr/>
)}
<style>
    social-links a.active {
        text-decoration: none;
        border-bottom-color: var(--accent);
    }
    .social-links,
    .social-links a {
        padding: 0 0.5em;
        color: var(--black);
        text-decoration: none;
        display: flex;
    }
</style>
