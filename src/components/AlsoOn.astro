                                <ellipse fill="white" cx="229" cy="42.5" rx="18" ry="17.5" transform="matrix(.860642 0 0 .821317 48.786 63.282)" />
                                <ellipse fill="white" cx="372" cy="54.5" rx="19" ry="16.5" transform="matrix(.860642 0 0 .895982 41.041 56.339)" />
                                <path fill="black" stroke="white" stroke-width="14" stroke-linejoin="round" d="m353.861 173.357c3.473 2.857 28.141 20.028 22.256 57.51-5.101 18.085-13.88 27.25-27.387 34.79-20.422 10.05-42.754 11.225-64.347 4.16-10.94-4.301-21.454-11.062-29.383-19.817l-2-2c-9.545-12.81-14.568-27.426-12.492-43.477 5.927-45.83 76.376-65.118 113.353-31.166zM217 315l1.309 1.77C265.22 369.754 338.919 354.392 360 348c-13.698 87.55-174.569 41.708-143-33zM249 272c16.182 16.238 50.957 32.383 103.992 16.18 5.754 4.08 8.94 23.506 7.008 32.82-98.042 27.947-129.715-26.57-129.715-26.57s6.332-17.047 18.715-22.43z" />
                                <path fill="black" stroke="white" stroke-width="14" stroke-linejoin="round" d="m188.18 195.82c9.85 5.42 24.804 13.312 30.82 25.18.509 2.44.877 4.785 1.188 7.25 1.866 11.965 8.205 21.472 15.812 30.75-2.224 5.802-7.725 9.517-13.073 12.297-9.879 4.145-20.103-2.955-20.103-2.955-88.664-41.565-69.545-102.544-14.645-72.522zM392.414 248.012c1.918-2.433 32.952-25.546 52.649-4.825 11.651 12.257-19.598 38.844-19.598 38.844-24.414 19.947-46.008 20.707-46.008 20.707-1.826-2.29-12.457-21.738-12.457-23.738 1.241-.958 2.512-1.875 3.813-2.75 9.027-6.845 18.383-15.326 21.601-28.238zM203 290c-3.76 4.6-9.946 16.896-11.289 19.488-2.705 5.167-3.69 16.05-9.219 17.887-36.244 17.315-28.856-24.861-11.761-33.298 1.159-.572 12.18-6.983 26.007-4.839 2.524.391 3.174.141 6.262.762z" />
                            </mask>
                        </defs>
                        <rect x="110" y="75" width="360" height="350" fill="currentColor" mask="url(#bookhive-bee-mask)" />
